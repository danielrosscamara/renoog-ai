# Backend base URL (no trailing slash)
VITE_API_URL=http://localhost:8000
# true = MSW serves fake data from src/mocks until the FastAPI routes exist. Must be false in production.
VITE_USE_MOCKS=true
# true = show Log out in the account menu. Phase 1 has no auth, so keep it false until Phase 2 ships /auth/logout.
VITE_AUTH_ENABLED=false
